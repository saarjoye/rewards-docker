{
  "name": "microsoft-rewards-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "State-aware Microsoft Rewards automation with strict session and task verification.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.eslint.json --noEmit",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "vite",
    "lint": "eslint .",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "verify:accounts": "node --env-file=.env --import tsx scripts/three-account-readonly.ts",
    "verify:app-readonly": "node --env-file=.env --import tsx scripts/app-offer-readonly.ts",
    "verify:full-account": "node --env-file=.env --import tsx scripts/single-account-full-run.ts",
    "verify:mutation": "node --env-file=.env --import tsx scripts/account-one-controlled-mutation.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.3",
    "croner": "9.1.0",
    "fastify": "5.12.1",
    "patchright": "1.61.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "10.4.0",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
