# Copy to runtime/web.env on the NAS. Never commit the real file.
CONTROL_API_TOKEN=replace-with-the-same-long-random-token-used-by-core

# Leave both empty to create the administrator on first browser visit.
WEB_ADMIN_USER=
WEB_ADMIN_PASSWORD=
WEB_COOKIE_SECURE=false

# Optional compatibility source. After saving in Web UI, the encrypted Web
# settings store becomes authoritative and these values can be removed.
WEB_WECOM_ENABLED=false
WEB_WECOM_CORP_ID=
WEB_WECOM_AGENT_ID=
WEB_WECOM_CORP_SECRET=
WEB_WECOM_TO_USER=@all
# WEB_WECOM_BASE_URL=https://trusted-proxy.example.com
