# Copy to runtime/core.env on the NAS. Never commit the real file.
TZ=Asia/Shanghai
API_TOKEN=replace-with-the-same-long-random-token-used-by-web
# Accounts are managed in Web UI after migration. Keep ACCOUNT_N_* only until
# the one-time migration is confirmed in the UI.

# Keep empty during staged validation. Enable only after every account passes.
CRON_SCHEDULE=
SKIP_RANDOM_SLEEP=false
MIN_SLEEP_MINUTES=5
MAX_SLEEP_MINUTES=50
STUCK_PROCESS_TIMEOUT_HOURS=8

ACCOUNT_1_EMAIL=user@example.com
# ACCOUNT_1_PASSWORD=
# ACCOUNT_1_TOTP_SECRET=
# ACCOUNT_1_RECOVERY_EMAIL=
ACCOUNT_1_GEO_LOCALE=auto
ACCOUNT_1_LANG_CODE=zh-CN
ACCOUNT_1_PROXY_HTTP=false
# ACCOUNT_1_PROXY_URL=
# ACCOUNT_1_PROXY_PORT=0
# ACCOUNT_1_PROXY_USERNAME=
# ACCOUNT_1_PROXY_PASSWORD=
ACCOUNT_1_SAVE_FINGERPRINT_MOBILE=false
ACCOUNT_1_SAVE_FINGERPRINT_DESKTOP=false

# Duplicate the ACCOUNT_N_* block with another positive slot number for more accounts.
