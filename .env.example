# Microsoft Rewards 账号密码凭据配置模板
# 支持三种写法：
# 1. user:xxx 换行 pass:xxx
# 2. MS_USER=xxx 换行 MS_PASS=xxx
# 3. account@domain.com:password

MS_USER=your_email@outlook.com
MS_PASS=your_password_here

# ── 远程部署 / 远程执行（scripts/deploy-to-remote.mjs、scripts/remote-exec.mjs）──
# 不要把主机、账号、密码写进源码；只放在 .env（已在 .gitignore 中）或 shell 环境变量里。
# 用法：node --env-file=.env scripts/remote-exec.mjs "pct list"
DEPLOY_SSH_HOST=
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=root
# SSH key 优先；支持 ~/.ssh/xxx，也支持绝对路径
DEPLOY_SSH_KEY=~/.ssh/id_ed25519
# 主机指纹：ssh-keyscan -t ed25519 <host> | ssh-keygen -lf -
# 支持 SHA256:... 或 hex；留空会跳过校验并打印警告
DEPLOY_SSH_HOST_FINGERPRINT=
# 仅在无法使用 key 时临时使用；不建议写进 .env，更不要提交
# DEPLOY_SSH_PASSWORD=

DEPLOY_REMOTE_DIR=/tmp/rewards-update
DEPLOY_CONTAINER=rewards-v3
DEPLOY_HEALTH_URL=http://127.0.0.1:8787/
