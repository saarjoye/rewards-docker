TZ=Asia/Shanghai
WEB_HOST=0.0.0.0
WEB_PORT=3000
WEB_ADMIN_USER=admin
WEB_ADMIN_PASSWORD=<set-on-first-start>
RUN_SCHEDULE=0 7 * * *
RUN_ON_START=false
CREDENTIAL_KEY_FILE=/run/secrets/rewards_master_key
DOWNLOAD_HTTP_PROXY=

# Source-machine read-only acceptance only. Production accounts are managed by the Web UI.
ACCOUNT_1_EMAIL=<acceptance-account-1>
ACCOUNT_1_PASSWORD=<acceptance-password-1>
ACCOUNT_2_EMAIL=<acceptance-account-2>
ACCOUNT_2_PASSWORD=<acceptance-password-2>
ACCOUNT_3_EMAIL=<acceptance-account-3>
ACCOUNT_3_PASSWORD=<acceptance-password-3>
